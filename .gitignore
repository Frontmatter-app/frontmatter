node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.claude/

dist-tmp/
modal_backend/**/__pycache__/
src-tauri/target/
src-tauri/gen/
src-tauri/node_modules/
src-tauri/.tauri/
# The Zola binary is fetched by scripts/fetch-zola.sh, not committed. Its
# license text ships beside it in the bundle, so that one file is tracked.
src-tauri/binaries/*
!src-tauri/binaries/LICENSE-zola
# Compiled Python bytecode. Architecture- and version-specific, so tracking it
# produces conflicts nobody can resolve and diffs nobody can read.
__pycache__/
*.py[cod]
