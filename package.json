{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "ipc:gen": "node scripts/generate-ipc.mjs",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --bin marktype",
    "test:watch": "vitest",
    "predev": "npm run test",
    "prebuild": "npm run test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
