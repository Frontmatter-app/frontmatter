{
  "indexes": [
    {
      "//": "Backs the single per-member listener: teamId equality crossed with an array-contains-any over the readableBy index.",
      "collectionGroup": "cloud_documents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "teamId", "order": "ASCENDING" },
        { "fieldPath": "readableBy", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "//": "Personal workspace: documents a user owns that belong to no team.",
      "collectionGroup": "cloud_documents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerId", "order": "ASCENDING" },
        { "fieldPath": "teamId", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
