# ──────────────────────────────────────────────────────────────────────────────
# Frontmatter (desktop app) — environment variables
#
#     cp .env.example .env
#
# EVERY VARIABLE HERE IS OPTIONAL, and most people need none of them.
# Frontmatter runs fully local with no .env at all: editor, draft/write/revise
# workflow, prose linting, git, and publishing all work offline with no account.
#
# A collaboration server is only needed for real-time collaboration, and the
# app can be pointed at one from Settings → Account without rebuilding. These
# variables just supply a default.
#
# For configuring the SERVER, see SELF_HOSTING.md — it reads `FM_`-prefixed
# variables, not these.
# ──────────────────────────────────────────────────────────────────────────────


# ── Collaboration server ──────────────────────────────────────────────────────
# Default server URL offered in Settings. Accounts, sign-in, and the
# collaboration socket are all resolved from this one value.
#
# Run your own with `docker compose up`.
VITE_SERVER_URL=http://localhost:8000

# Only needed if the websocket lives on a different host from the HTTP API.
# Normally leave this empty — it is derived from VITE_SERVER_URL.
# VITE_COLLAB_WS_URL=ws://localhost:8000/collab
