# ──────────────────────────────────────────────────────────────────────────────
# Frontmatter — environment variables
#
# Copy to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# EVERY VARIABLE HERE IS OPTIONAL. Frontmatter runs fully local with an empty
# .env — editor, workflow, prose linting, git, and publishing all work offline
# with no account. `src/auth/firebase.ts` falls back to a dummy config so the
# app compiles and boots without a Firebase project.
#
# These are all `VITE_`-prefixed, which means Vite compiles them into the
# shipped client bundle. Never put a secret with server authority here. Server
# credentials belong in the server's own environment — see SELF_HOSTING.md.
# ──────────────────────────────────────────────────────────────────────────────


# ── Self-hosted collaboration ─────────────────────────────────────────────────
# Point the app at your own collaboration server. This is the only variable
# needed to self-host the collaboration layer.
#
# Takes precedence over VITE_MODAL_BASE_URL for the websocket connection.
# Use ws:// for local development, wss:// for anything over a network.
VITE_COLLAB_WS_URL=ws://localhost:8000/collab


# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the Frontmatter server (billing, teams, invites, assets, and the
# collaboration socket when VITE_COLLAB_WS_URL is unset).
VITE_MODAL_BASE_URL=http://localhost:8000

# Asset/image storage API. Usually the same host as above.
VITE_R2_API_BASE_URL=http://localhost:8000


# ── Firebase (LEGACY — being removed) ─────────────────────────────────────────
# Frontmatter is moving off Firebase entirely. Accounts are handled by the
# collaboration server itself, and documents live in your git repository rather
# than Firestore. This whole block exists only for the current hosted service
# and will be deleted; do not build anything new against it.
#
# LEAVE IT EMPTY. Self-hosting has never required a Firebase project.
#
# From Firebase console → Project Settings → Your apps → Web app.
# These are public client identifiers, not secrets: Firebase security comes
# from firestore.rules, not from hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desktop Google sign-in. The OAuth *client secret* is held by the server, not
# here — the desktop app only ever sends the client id.
VITE_GOOGLE_CLIENT_ID=

# Where a magic-link email returns the user. Required under Tauri, because
# Firebase rejects `tauri://localhost` as a continue URL.
VITE_MAGIC_LINK_CONTINUE_URL=


# ── Billing ───────────────────────────────────────────────────────────────────
# Creem product ids. Only needed if you are running your own paid service.
#
# There are deliberately no defaults in code: a previous build shipped
# fallbacks that were inverted relative to the server's, so buyers were sent to
# one product and granted the other. Both sides now read these same vars.
VITE_CREEM_AUTHOR_PRD_ID=
VITE_CREEM_TEAM_PRD_ID=


# ── Development only ──────────────────────────────────────────────────────────
# Bypasses real authentication with a fake local user. Only honoured when
# Vite is in dev mode, and never in a production build.
VITE_ALLOW_MOCK_AUTH=false
