{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Frontmatter contributors. Licensed under the GNU AGPL v3 or later.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "Frontmatter is a markdown writing app built around a draft/write/revise workflow, with live preview, math, diagrams, prose linting, real-time collaboration, and static site publishing. Your documents stay plain markdown files in your own git repository.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "binaries/*"
    ],
    "shortDescription": "Markdown writing, backed by your own git repository.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Frontmatter",
  "mainBinaryName": "Frontmatter",
  "version": "1.0.0",
  "identifier": "com.frontmatter.app",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "",
        "width": 1200,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$DOCUMENT/**",
            "$DOCUMENT/**/.*/**",
            "$HOME/**",
            "$HOME/**/.*/**",
            "$RESOURCE/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  }
}