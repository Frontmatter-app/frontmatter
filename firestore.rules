rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────────
    // Identity
    // ──────────────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // Entitlement
    //
    // `plan` and `planStatus` live on users/{uid} but are writable only by the
    // billing webhook through the Admin SDK — see the users match below, which
    // rejects any client write that touches them. Before that, these fields were
    // self-writable, so `hasActivePlan()` amounted to asking the caller whether
    // they had paid.
    // ──────────────────────────────────────────────────────────────────────────
    function hasActivePlan() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             // 'completed' is legacy: the webhook normalises it to 'active' before
             // writing, but rows predating that normalisation still carry it.
             (userDoc().get('planStatus', null) == 'active' ||
              userDoc().get('planStatus', null) == 'completed') &&
             (userDoc().get('plan', null) == 'author' ||
              userDoc().get('plan', null) == 'team' ||
              userDoc().get('plan', null) == 'enterprise');
    }

    // ──────────────────────────────────────────────────────────────────────────
    // Team membership
    //
    // Membership is a document under the team, written only by the backend. It
    // used to be read from the caller's own users/{uid} record — `ownedTeamId`,
    // `teamMemberships`, or a legacy `teamId` — all of which the caller could
    // write. One `setDoc` on your own profile was enough to join any team and
    // read, edit, and delete its documents.
    //
    // The membership document also carries `groupIds`, which collapses the group
    // check from an unrolled OR over ten groups (up to 31 document reads, and
    // silently blind to any group past the tenth) into a single read.
    // ──────────────────────────────────────────────────────────────────────────
    function membershipPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid);
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function isTeamOwnerOf(teamId) {
      return isSignedIn() &&
             exists(teamPath(teamId)) &&
             get(teamPath(teamId)).data.get('ownerId', null) == request.auth.uid;
    }

    function isTeamMember(teamId) {
      return isSignedIn() && (exists(membershipPath(teamId)) || isTeamOwnerOf(teamId));
    }

    function myGroupIds(teamId) {
      return exists(membershipPath(teamId))
        ? get(membershipPath(teamId)).data.get('groupIds', [])
        : [];
    }

    function isInAnyGroup(teamId, groupIds) {
      return groupIds.size() > 0 && myGroupIds(teamId).hasAny(groupIds);
    }

    // ──────────────────────────────────────────────────────────────────────────
    // Per-file permissions
    // ──────────────────────────────────────────────────────────────────────────
    function getFilePermissionsVisibleTo(data) {
      return data.get('filePermissions', null) != null && data.get('filePermissions', null).get('visibleTo', null) != null
        ? data.get('filePermissions', null).get('visibleTo', [])
        : [];
    }

    function getFilePermissionsWritableBy(data) {
      return data.get('filePermissions', null) != null && data.get('filePermissions', null).get('writableBy', null) != null
        ? data.get('filePermissions', null).get('writableBy', [])
        : [];
    }

    // ── readableBy: the query index ───────────────────────────────────────────
    //
    // Firestore cannot express "documents visible to me", so each document
    // carries a flat array a single `array-contains-any` query can match:
    // the group ids in `filePermissions.visibleTo`, or the sentinel '*' when
    // unrestricted, plus the owner's uid.
    //
    // It is deliberately NOT the authorization check — `canReadDocumentData`
    // below still decides access from the real permissions, so a forged index
    // cannot widen anyone's access. These rules only keep it *honest*, so that
    // a document cannot be made to disappear from, or wrongly appear in, other
    // members' listeners.
    function expectedReadableBy(data) {
      let visibleTo = getFilePermissionsVisibleTo(data);
      let owner = data.get('ownerId', null);
      let base = visibleTo.size() == 0 ? ['*'] : visibleTo;
      return owner == null ? base : base.concat([owner]);
    }

    function readableByMatchesPermissions(data) {
      let expected = expectedReadableBy(data);
      let actual = data.get('readableBy', []);
      return actual.hasAll(expected) && actual.hasOnly(expected);
    }

    // Documents written before the index existed have no `readableBy`. They
    // stay writable as long as the write does not introduce one, so a backfill
    // can trail a deploy without locking anyone out of their own documents.
    function readableByIsValid(prevResource, nextData) {
      let hadIndex = prevResource != null && 'readableBy' in prevResource.data;
      let hasIndex = 'readableBy' in nextData;
      return hasIndex
        ? readableByMatchesPermissions(nextData)
        : !hadIndex;
    }

    function canReadDocumentData(docData) {
      let docTeamId = docData.get('teamId', null);
      let visibleTo = getFilePermissionsVisibleTo(docData);
      return isSignedIn() && (
        docData.get('ownerId', null) == request.auth.uid ||
        (docTeamId != null &&
         isTeamMember(docTeamId) &&
         (
           // An empty list means "no restriction set" — open to the whole team.
           visibleTo.size() == 0 ||
           isTeamOwnerOf(docTeamId) ||
           isInAnyGroup(docTeamId, visibleTo)
         ))
      );
    }

    function canWriteDocumentResource(res, reqRes) {
      let docData = res.data;
      let docTeamId = docData.get('teamId', null);
      let writableBy = getFilePermissionsWritableBy(docData);
      // On delete, reqRes is null, so fall back to the stored teamId.
      let effectiveTeamId = docTeamId != null ? docTeamId : (reqRes != null ? reqRes.data.get('teamId', null) : null);

      return isSignedIn() && (
        docData.get('ownerId', null) == request.auth.uid ||
        (effectiveTeamId != null &&
         isTeamMember(effectiveTeamId) &&
         (
           writableBy.size() == 0 ||
           isTeamOwnerOf(effectiveTeamId) ||
           isInAnyGroup(effectiveTeamId, writableBy)
         ))
      );
    }

    // A write may not change the fields the authorization decision was made
    // from. Without this, any member with write access could take ownership of a
    // document, move it into another team, or rewrite its permissions — the
    // update rule only ever compared against `resource.data`, the *old* document.
    function documentIdentityUnchanged() {
      return request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null) &&
             request.resource.data.get('teamId', null) == resource.data.get('teamId', null);
    }

    // Retargeting who can see or edit a document is the owner's call, not any
    // writer's. This was enforced only in the client.
    function permissionsWritableByCaller() {
      let touchesPermissions = request.resource.data.diff(resource.data).affectedKeys()
                                 .hasAny(['filePermissions', 'readableBy']);
      let docTeamId = resource.data.get('teamId', null);
      return !touchesPermissions ||
             resource.data.get('ownerId', null) == request.auth.uid ||
             (docTeamId != null && isTeamOwnerOf(docTeamId));
    }

    function canReadDocument(docId) {
      return exists(/databases/$(database)/documents/cloud_documents/$(docId)) &&
             canReadDocumentData(get(/databases/$(database)/documents/cloud_documents/$(docId)).data);
    }

    function canWriteDocument(docId) {
      return (
        exists(/databases/$(database)/documents/cloud_documents/$(docId)) &&
        canWriteDocumentResource(get(/databases/$(database)/documents/cloud_documents/$(docId)), request.resource)
      ) || (
        !exists(/databases/$(database)/documents/cloud_documents/$(docId)) &&
        request.resource != null &&
        request.resource.data.get('teamId', null) != null &&
        isTeamMember(request.resource.data.get('teamId', null))
      );
    }

    // ──────────────────────────────────────────────────────────────────────────
    // users/{uid}
    //
    // Self-readable and self-writable, but only for profile fields. Everything
    // the security rules make a decision from is off-limits to the client.
    //
    // Reads were previously open to any signed-in user, which exposed every
    // account's email, plan, and Creem customer id. The team roster now reads
    // display names from the membership documents under the team instead.
    // ──────────────────────────────────────────────────────────────────────────
    function userLockedFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['plan', 'planStatus', 'creemCustomerId', 'ownedTeamId', 'teamId', 'teamMemberships']);
    }

    function userCreateIsClean() {
      return request.resource.data.get('plan', 'free') == 'free' &&
             request.resource.data.get('planStatus', null) == null &&
             !request.resource.data.keys()
                .hasAny(['creemCustomerId', 'ownedTeamId', 'teamId', 'teamMemberships']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && userCreateIsClean();
      allow update: if isOwner(uid) && userLockedFieldsUntouched();
      allow delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // teams/{teamId}
    // ──────────────────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      // Creating a team requires a real team plan. `plan` is server-written, so
      // unlike before this cannot be self-asserted. `planStatus` is now checked
      // too — it was omitted here while every other entitlement gate required it.
      allow create: if isSignedIn() &&
                       request.resource.data.get('ownerId', null) == request.auth.uid &&
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       (userDoc().get('plan', null) == 'team' ||
                        userDoc().get('plan', null) == 'enterprise') &&
                       (userDoc().get('planStatus', null) == 'active' ||
                        userDoc().get('planStatus', null) == 'completed');

      allow update, delete: if isSignedIn() && resource.data.get('ownerId', null) == request.auth.uid;

      allow read: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid ||
        isTeamMember(teamId)
      );

      // ── Membership records ────────────────────────────────────────────────
      // Written only by the backend (Admin SDK), because this document *is* the
      // proof of membership. It also carries the member's display name and photo
      // so the roster never needs to read other people's users/{uid} records.
      match /members/{memberUid} {
        allow read: if isSignedIn() && (isOwner(memberUid) || isTeamMember(teamId));
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // invites/{inviteId}
    //
    // Fully backend-managed. Every field is security-relevant:
    //
    //  - `read: if true` allowed anyone, signed in or not, to enumerate the
    //    collection and harvest every invitee email, team id, and live `token`
    //    — the token being the only bearer secret in the join flow.
    //  - `create` was gated on the caller's own `users/{uid}.plan`, which the
    //    caller could write, and validated no field of the invite. That let
    //    anyone mint a self-addressed invite to any team and join it.
    //
    // The landing page reads invite details from GET /invite-details/{token},
    // which returns only what it needs and never echoes the token back.
    // ──────────────────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read, create, update, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // agreements/{agreementId}
    // ──────────────────────────────────────────────────────────────────────────
    match /agreements/{agreementId} {
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        isTeamOwnerOf(resource.data.teamId)
      );
    }

    // ──────────────────────────────────────────────────────────────────────────
    // cloud_documents/{docId}
    // ──────────────────────────────────────────────────────────────────────────
    match /cloud_documents/{docId} {
      allow read: if resource != null && canReadDocumentData(resource.data);

      allow update: if canWriteDocumentResource(resource, request.resource) &&
                       documentIdentityUnchanged() &&
                       permissionsWritableByCaller() &&
                       readableByIsValid(resource, request.resource.data);
      allow delete: if canWriteDocumentResource(resource, request.resource);

      // New document creation — must be signed in with an Author+ plan, or
      // belong to a team the user is a member of. A new document must carry a
      // correct query index; there is no legacy case to accommodate on create.
      allow create: if isSignedIn() &&
        readableByMatchesPermissions(request.resource.data) && (
        (hasActivePlan() && request.resource.data.get('ownerId', null) == request.auth.uid) ||
        (request.resource.data.get('teamId', null) != null && isTeamMember(request.resource.data.get('teamId', null)))
      );

      // ── Yjs update chunks subcollection ──────────────────────────────────
      // Retired once the WebSocket sync server lands; the client will no longer
      // read or write these.
      match /updates/{updateId} {
        allow read: if canReadDocument(docId);
        allow create: if canWriteDocument(docId);
        allow delete: if false;
      }

      // ── Presence subcollection (cursors / awareness) ──────────────────────
      // Any reader can publish their cursor; write permission is NOT required
      // to broadcast presence — this keeps cursor sync working for read-only
      // members. Also retired by the sync server, which relays awareness in
      // memory instead.
      match /presence/{clientId} {
        allow read: if canReadDocument(docId);
        allow write, delete: if canReadDocument(docId);
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // cloud_folders/{folderId}
    // ──────────────────────────────────────────────────────────────────────────
    match /cloud_folders/{folderId} {
      allow read: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid ||
        (resource.data.get('teamId', null) != null &&
         isTeamMember(resource.data.get('teamId', null)))
      );

      allow create: if isSignedIn() && (
        (hasActivePlan() && request.resource.data.get('ownerId', null) == request.auth.uid) ||
        (request.resource.data.get('teamId', null) != null &&
         isTeamMember(request.resource.data.get('teamId', null)))
      );

      allow update, delete: if isSignedIn() && (
        resource.data.get('ownerId', null) == request.auth.uid ||
        (resource.data.get('teamId', null) != null &&
         isTeamMember(resource.data.get('teamId', null)))
      );
    }
  }
}
